@model Iscuissatis.Web.Models.ProductFormViewModel

<section class="mt-10 max-w-4xl">
    <h2 class="text-xl">Imagens</h2>
    <p class="mt-1 text-sm text-muted">
        Aceitamos JPEG, PNG e WebP até 5 MB. O arquivo é reprocessado e convertido para WebP.
        A primeira imagem vira a principal.
    </p>

    @if (Model.Images.Count > 0)
    {
        <ul class="mt-4 grid gap-4 sm:grid-cols-3">
            @foreach (var image in Model.Images)
            {
                <li class="card p-3">
                    <img src="@image.Path" alt="@image.AltText" width="320" height="240"
                         class="aspect-[4/3] w-full rounded object-cover" loading="lazy"/>
                    <p class="mt-2 text-xs text-muted">@image.AltText</p>
                    <p class="text-[11px] text-muted">@image.Width × @image.Height px</p>

                    <div class="mt-3 flex items-center justify-between gap-2">
                        @if (image.IsPrimary)
                        {
                            <span class="text-[10px] font-bold uppercase tracking-[0.1em] text-olive-dark">Principal</span>
                        }
                        else
                        {
                            <form method="post" asp-action="SetPrimaryImage" asp-route-id="@Model.Form.Id" asp-route-imageId="@image.Id">
                                <button type="submit" class="text-xs underline text-muted hover:text-primary">Tornar principal</button>
                            </form>
                        }

                        <form method="post" asp-action="RemoveImage" asp-route-id="@Model.Form.Id" asp-route-imageId="@image.Id">
                            <button type="submit" class="text-xs underline text-primary">Remover</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="card mt-4 text-sm text-muted">Nenhuma imagem ainda. Sem imagem não é possível publicar.</p>
    }

    <form method="post" asp-action="UploadImage" asp-route-id="@Model.Form.Id"
          enctype="multipart/form-data" class="card mt-6">
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="field">
                <label for="file">Arquivo</label>
                <input id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp" required/>
            </div>
            <div class="field">
                <label for="altText">Texto alternativo</label>
                <input id="altText" name="altText" placeholder="Sabonete de lavanda sobre mesa de madeira" required/>
            </div>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Enviar imagem</button>
    </form>
</section>
