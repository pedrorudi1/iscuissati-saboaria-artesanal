@model Iscuissatis.Web.Areas.Admin.Controllers.AuthenticatorSetupViewModel
@{
    ViewData["Title"] = "Verificação em duas etapas";
}

<section class="max-w-3xl">
    <p class="eyebrow">Segurança</p>
    <h2 class="mt-2 text-2xl">Verificação em duas etapas</h2>

    @if (Model.IsEnabled)
    {
        <div class="card mt-6">
            <p class="font-display uppercase tracking-[0.08em] text-sm text-olive-dark">Ativada</p>
            <p class="mt-2 text-sm text-muted">
                Sua conta exige um código do aplicativo autenticador a cada login.
                Códigos de recuperação restantes: <strong>@Model.RecoveryCodesLeft</strong>.
            </p>
            <form method="post" asp-action="RegenerateRecoveryCodes" class="mt-4">
                <button type="submit" class="btn btn-outline">Gerar novos códigos de recuperação</button>
            </form>
        </div>
    }
    else
    {
        <div class="card mt-6">
            <p class="text-sm text-muted">
                O painel exige verificação em duas etapas. Escaneie o código abaixo com
                Google Authenticator, Microsoft Authenticator, 1Password ou outro aplicativo TOTP.
            </p>

            <div class="mt-6 grid gap-6 sm:grid-cols-[200px_1fr] sm:items-start">
                <img src="@Model.QrCodeDataUri" width="200" height="200"
                     alt="Código QR para configurar o aplicativo autenticador" class="rounded border border-line"/>

                <div>
                    <p class="text-[11px] uppercase tracking-[0.18em] text-muted">Ou digite a chave</p>
                    <p class="mt-1 break-all font-mono text-sm text-ink">@Model.SharedKey</p>
                    <p class="mt-3 text-xs text-muted">Tipo: TOTP · 6 dígitos · 30 segundos</p>
                </div>
            </div>

            <form method="post" asp-action="Enable" asp-route-returnUrl="@Model.ReturnUrl" class="mt-6 max-w-sm">
                <div asp-validation-summary="ModelOnly" class="form__error mb-4" role="alert"></div>

                <div class="field">
                    <label for="code">Código de 6 dígitos</label>
                    <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code"
                           maxlength="6" pattern="[0-9]{6}" required/>
                </div>

                <button type="submit" class="btn btn-primary w-full">Ativar verificação em duas etapas</button>
            </form>
        </div>

        <p class="mt-4 text-xs text-muted">
            Enquanto não ativar, o painel fica bloqueado — só esta página é acessível.
        </p>
    }
</section>
