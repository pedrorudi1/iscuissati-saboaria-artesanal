@model Iscuissatis.Web.Models.CategoryFormModel
@{
    var isEdit = Model.Id != Guid.Empty;
    ViewData["Title"] = isEdit ? "Editar categoria" : "Nova categoria";
    var postUrl = isEdit ? $"/admin/categorias/{Model.Id}/editar" : "/admin/categorias/nova";
}

<section class="max-w-2xl">
    <p class="text-sm text-muted">
        O endereço da categoria é gerado a partir do nome e não muda depois —
        assim links já compartilhados continuam funcionando.
    </p>

    <form method="post" action="@postUrl" class="card mt-6">
        <div asp-validation-summary="ModelOnly" class="form__error mb-4" role="alert"></div>

        <div class="field">
            <label asp-for="Name"></label>
            <input asp-for="Name" autofocus/>
            <span asp-validation-for="Name" class="form__error"></span>
        </div>

        <div class="field">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" rows="3"></textarea>
            <span asp-validation-for="Description" class="form__error"></span>
        </div>

        <div class="field">
            <label asp-for="SortOrder"></label>
            <input asp-for="SortOrder" type="number" min="0" max="999"/>
            <span asp-validation-for="SortOrder" class="form__error"></span>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
            <button type="submit" class="btn btn-primary">@(isEdit ? "Salvar alterações" : "Criar categoria")</button>
            <a class="btn btn-outline" asp-action="Index">Cancelar</a>
        </div>
    </form>
</section>
