@{
    ViewData["Title"] = "Dashboard";
}

<section class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
    <article class="card">
        <p class="text-[11px] uppercase tracking-[0.18em] text-muted">Vendas hoje</p>
        <p class="mt-2 font-display text-3xl">—</p>
        <p class="mt-1 text-xs text-muted">Aparece quando os pedidos existirem (Fase 8).</p>
    </article>
    <article class="card">
        <p class="text-[11px] uppercase tracking-[0.18em] text-muted">Pedidos pendentes</p>
        <p class="mt-2 font-display text-3xl">—</p>
        <p class="mt-1 text-xs text-muted">Aguardando pagamento ou preparo.</p>
    </article>
    <article class="card">
        <p class="text-[11px] uppercase tracking-[0.18em] text-muted">Produtos publicados</p>
        <p class="mt-2 font-display text-3xl">—</p>
        <p class="mt-1 text-xs text-muted">O catálogo entra na Fase 2.</p>
    </article>
    <article class="card">
        <p class="text-[11px] uppercase tracking-[0.18em] text-muted">Estoque baixo</p>
        <p class="mt-2 font-display text-3xl">—</p>
        <p class="mt-1 text-xs text-muted">Alerta a partir de 5 unidades.</p>
    </article>
</section>

<section class="card mt-8">
    <h2 class="text-xl">Próximos passos</h2>
    <ol class="mt-4 space-y-2 text-sm text-muted list-decimal list-inside">
        <li>Cadastro de categorias, produtos e variações (Fase 2).</li>
        <li>Vitrine e página de produto (Fase 3).</li>
        <li>Carrinho e checkout com Pix (Fases 4 e 5).</li>
    </ol>
    <p class="mt-4 text-sm">
        <a class="underline text-primary" href="/">Ver a loja</a>
    </p>
</section>
