@using Iscuissatis.Domain.Sales
@model Iscuissatis.Domain.Sales.Order
@{
    var label = Model.Status switch
    {
        OrderStatus.PendingPayment => "Aguardando pagamento",
        OrderStatus.Paid => "Pago",
        OrderStatus.Preparing => "Em preparo",
        OrderStatus.Shipped => "Enviado",
        OrderStatus.Delivered => "Entregue",
        OrderStatus.Canceled => "Cancelado",
        _ => "Reembolsado",
    };
}

@if (ViewData["Message"] is string message && !string.IsNullOrWhiteSpace(message))
{
    <p class="card mb-6 border-l-4 border-l-olive text-sm" role="status">@message</p>
}
@if (ViewData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
{
    <p class="card mb-6 border-l-4 border-l-primary text-sm" role="alert">@error</p>
}

<p class="text-sm text-muted">
    <a class="underline" href="/admin/pedidos">← Voltar para pedidos</a>
</p>

<div class="mt-4 grid gap-6 lg:grid-cols-[1.5fr_1fr] lg:items-start">
    <div class="card">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-[11px] uppercase tracking-[0.18em] text-muted">Pedido</p>
                <p class="font-display text-2xl">@Model.Number</p>
            </div>
            <span class="rounded border border-line px-3 py-2 text-xs uppercase tracking-[0.1em] text-muted">@label</span>
        </div>

        <ul class="mt-6 space-y-3 text-sm">
            @foreach (var item in Model.Items)
            {
                <li class="flex justify-between gap-3 border-b border-line pb-2">
                    <span>@item.Quantity × @item.ProductName <span class="text-muted">(@item.VariantName)</span></span>
                    <span class="whitespace-nowrap">R$ @item.LineTotal.ToString("N2")</span>
                </li>
            }
        </ul>

        <dl class="mt-4 space-y-1 text-sm">
            <div class="flex justify-between"><dt class="text-muted">Subtotal</dt><dd>R$ @Model.Subtotal.ToString("N2")</dd></div>
            <div class="flex justify-between"><dt class="text-muted">Frete</dt><dd>R$ @Model.Shipping.ToString("N2")</dd></div>
            @if (Model.Discount > 0)
            {
                <div class="flex justify-between"><dt class="text-muted">Desconto</dt><dd>− R$ @Model.Discount.ToString("N2")</dd></div>
            }
            <div class="flex justify-between border-t border-line pt-2 font-bold"><dt>Total</dt><dd>R$ @Model.Total.ToString("N2")</dd></div>
        </dl>
    </div>

    <aside class="space-y-6">
        <div class="card">
            <h2 class="text-lg">Entrega</h2>
            <div class="mt-3 text-sm text-muted">
                <p>@Model.ShippingAddress.Recipient</p>
                <p>@Model.ShippingAddress.Street, @Model.ShippingAddress.Number @Model.ShippingAddress.Complement</p>
                <p>@Model.ShippingAddress.District — @Model.ShippingAddress.City / @Model.ShippingAddress.State</p>
                <p>CEP @Model.ShippingAddress.ZipCode</p>
            </div>
        </div>

        <div class="card">
            <h2 class="text-lg">Contato</h2>
            <p class="mt-2 text-sm text-muted">@(Model.GuestEmail ?? "Cliente com conta")</p>
            <p class="mt-1 text-xs text-muted">Criado em @Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")</p>
        </div>

        @if (Model.Status is OrderStatus.PendingPayment or OrderStatus.Paid or OrderStatus.Preparing)
        {
            <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="card">
                <h2 class="text-lg">Cancelar pedido</h2>
                <p class="mt-2 text-sm text-muted">O estoque reservado volta para a loja.</p>
                <button type="submit" class="btn btn-outline mt-3">Cancelar pedido</button>
            </form>
        }
    </aside>
</div>
