@model TwoFactorViewModel
@{
    ViewData["Title"] = "Verificação em duas etapas";
    Layout = "_AuthLayout";
}

<section class="card">
    <h1 class="text-2xl text-primary">Confirme o código</h1>
    <p class="mt-2 text-sm text-muted">
        Abra o aplicativo autenticador e informe o código de 6 dígitos da sua conta.
    </p>

    <form method="post" asp-controller="Account" asp-action="TwoFactor"
          asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe" class="mt-6">
        <div asp-validation-summary="ModelOnly" class="form__error mb-4" role="alert"></div>

        <div class="field">
            <label asp-for="Code">Código do autenticador</label>
            <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code"
                   maxlength="6" pattern="[0-9]{6}" autofocus/>
            <span asp-validation-for="Code" class="form__error"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-2 w-full">Entrar</button>
    </form>

    <p class="mt-6 text-center text-xs text-muted">
        Perdeu o acesso ao aplicativo? Use um código de recuperação no lugar dos 6 dígitos.
    </p>
    <p class="mt-2 text-center text-xs">
        <a class="underline hover:text-primary" asp-controller="Account" asp-action="Login">Voltar</a>
    </p>
</section>
