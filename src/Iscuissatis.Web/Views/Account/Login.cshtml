@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_AuthLayout";
}

<section class="card">
    <h1 class="text-2xl text-primary">Entrar no painel</h1>
    <p class="mt-2 text-sm text-muted">Acesso restrito à equipe da saboaria.</p>

    <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="mt-6">
        <div asp-validation-summary="ModelOnly" class="form__error mb-4" role="alert"></div>

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" inputmode="email"/>
            <span asp-validation-for="Email" class="form__error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password"/>
            <span asp-validation-for="Password" class="form__error"></span>
        </div>

        <label class="flex items-center gap-3 min-h-11">
            <input asp-for="RememberMe" class="size-5 accent-primary"/>
            <span class="text-sm text-muted">Continuar conectado</span>
        </label>

        <button type="submit" class="btn btn-primary mt-6 w-full">Entrar</button>
    </form>

    <p class="mt-6 text-center text-xs text-muted">
        <a class="underline hover:text-primary" href="/">Voltar para a loja</a>
    </p>
</section>
