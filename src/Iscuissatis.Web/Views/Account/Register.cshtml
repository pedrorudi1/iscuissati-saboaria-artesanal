@model Iscuissatis.Web.Models.RegisterModel
@{
    ViewData["Title"] = "Criar conta";
    Layout = "_AuthLayout";
}

<section class="card">
    <h1 class="text-2xl text-primary">Criar conta</h1>
    <p class="mt-2 text-sm text-muted">Acompanhe seus pedidos e agilize a próxima compra.</p>

    <form method="post" asp-controller="Account" asp-action="Register" class="mt-6">
        <div asp-validation-summary="ModelOnly" class="form__error mb-4" role="alert"></div>

        <div class="field">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" autocomplete="name"/>
            <span asp-validation-for="FullName" class="form__error"></span>
        </div>

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email"/>
            <span asp-validation-for="Email" class="form__error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password"/>
            <span asp-validation-for="Password" class="form__error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password"/>
            <span asp-validation-for="ConfirmPassword" class="form__error"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-2 w-full">Criar conta</button>
    </form>

    <p class="mt-6 text-center text-xs text-muted">
        Já tem conta? <a class="underline hover:text-primary" asp-controller="Account" asp-action="Login">Entrar</a>
    </p>
</section>
