@model Iscuissatis.Web.Controllers.LegalPage

<section class="container-page py-12">
    <div class="max-w-3xl">
        <p class="eyebrow">Institucional</p>
        <h1 class="mt-2 text-3xl md:text-[38px] text-primary">@Model.Title</h1>
        <p class="mt-3 text-muted">@Model.Intro</p>

        <p class="mt-6 card border-l-4 border-l-olive text-sm" role="note">
            <strong>Texto provisório.</strong> Este conteúdo precisa de revisão e dados reais
            (razão social, CNPJ, canais de atendimento) antes da publicação da loja.
        </p>

        <div class="mt-8 space-y-8">
            @foreach (var block in Model.Sections)
            {
                <div>
                    <h2 class="text-xl">@block.Heading</h2>
                    <p class="mt-2 text-muted">@block.Body</p>
                </div>
            }
        </div>
    </div>
</section>
