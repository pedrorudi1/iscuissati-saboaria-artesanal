@model IReadOnlyList<Iscuissatis.Domain.Sales.Order>
@{
    var status = new Func<Iscuissatis.Domain.Sales.OrderStatus, string>(value => value switch
    {
        Iscuissatis.Domain.Sales.OrderStatus.PendingPayment => "Aguardando pagamento",
        Iscuissatis.Domain.Sales.OrderStatus.Paid => "Pago",
        Iscuissatis.Domain.Sales.OrderStatus.Preparing => "Em preparo",
        Iscuissatis.Domain.Sales.OrderStatus.Shipped => "Enviado",
        Iscuissatis.Domain.Sales.OrderStatus.Delivered => "Entregue",
        Iscuissatis.Domain.Sales.OrderStatus.Canceled => "Cancelado",
        _ => "Reembolsado",
    });
}

<section class="container-page py-10">
    <p class="eyebrow">Minha conta</p>
    <h1 class="mt-2 text-3xl md:text-[38px] text-primary">Meus pedidos</h1>
    <p class="mt-2 text-sm text-muted">Olá, @User.Identity?.Name.</p>

    @if (Model.Count == 0)
    {
        <div class="card mt-6 text-center">
            <p class="font-display uppercase tracking-[0.08em] text-sm text-muted">Nenhum pedido ainda</p>
            <p class="mt-2 text-sm text-muted">Quando você comprar, o pedido aparece aqui.</p>
            <p class="mt-4"><a class="btn btn-primary" href="/sabonetes">Ver sabonetes</a></p>
        </div>
    }
    else
    {
        <div class="card mt-6 overflow-x-auto p-0">
            <table class="w-full text-left text-sm">
                <thead class="bg-bg">
                    <tr class="font-display uppercase tracking-[0.08em] text-[11px] text-muted">
                        <th scope="col" class="px-5 py-3">Pedido</th>
                        <th scope="col" class="px-5 py-3">Data</th>
                        <th scope="col" class="px-5 py-3">Situação</th>
                        <th scope="col" class="px-5 py-3 text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr class="border-t border-line">
                        <td class="px-5 py-3">
                            <a class="font-mono text-xs underline text-primary" href="/minha-conta/pedidos/@order.Number">@order.Number</a>
                        </td>
                        <td class="px-5 py-3 text-muted">@order.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="px-5 py-3">@status(order.Status)</td>
                        <td class="px-5 py-3 text-right">R$ @order.Total.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
