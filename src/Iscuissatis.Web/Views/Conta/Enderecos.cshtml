@model IReadOnlyList<Iscuissatis.Domain.Sales.Address>
@{
    var error = Context.Request.Query["erro"].ToString();
}

<section class="container-page py-10">
    <nav aria-label="Você está aqui" class="text-xs text-muted">
        <a class="hover:text-primary" href="/minha-conta">Minha conta</a>
        <span> / </span>
        <span>Endereços</span>
    </nav>

    <h1 class="mt-2 text-2xl text-primary">Meus endereços</h1>
    <p class="mt-1 text-sm text-muted">O endereço padrão já vem preenchido no checkout.</p>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="card mt-4 border-l-4 border-l-primary text-sm" role="alert">@error</p>
    }

    @if (Model.Count > 0)
    {
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            @foreach (var address in Model)
            {
                <li class="card">
                    <div class="flex items-center justify-between gap-2">
                        <p class="font-display uppercase tracking-[0.08em] text-sm">@address.Label</p>
                        @if (address.IsDefault)
                        {
                            <span class="text-[10px] uppercase tracking-[0.1em] text-olive-dark">Padrão</span>
                        }
                    </div>
                    <p class="mt-2 text-sm text-muted">@address.Recipient</p>
                    <p class="text-sm text-muted">@address.Street, @address.Number @address.Complement</p>
                    <p class="text-sm text-muted">@address.District — @address.City / @address.State</p>
                    <p class="text-sm text-muted">CEP @address.ZipCode</p>

                    <div class="mt-3 flex items-center gap-4">
                        @if (!address.IsDefault)
                        {
                            <form method="post" asp-action="SetDefaultAddress" asp-route-id="@address.Id">
                                <button type="submit" class="text-xs underline text-muted hover:text-primary">Tornar padrão</button>
                            </form>
                        }
                        @if (Model.Count > 1)
                        {
                            <form method="post" asp-action="DeleteAddress" asp-route-id="@address.Id">
                                <button type="submit" class="text-xs underline text-primary">Excluir</button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="card mt-6 text-sm text-muted">Nenhum endereço salvo ainda.</p>
    }

    <form method="post" asp-action="CreateAddress" class="card mt-8 max-w-2xl">
        @Html.AntiForgeryToken()
        <h2 class="text-lg">Novo endereço</h2>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div class="field">
                <label for="Label">Apelido</label>
                <input id="Label" name="Label" placeholder="Casa" required/>
            </div>
            <div class="field">
                <label for="Recipient">Quem recebe</label>
                <input id="Recipient" name="Recipient" required/>
            </div>
            <div class="field">
                <label for="ZipCode">CEP</label>
                <input id="ZipCode" name="ZipCode" inputmode="numeric" maxlength="9" placeholder="18300-000"/>
            </div>
            <div class="field">
                <label for="District">Bairro</label>
                <input id="District" name="District"/>
            </div>
            <div class="field sm:col-span-2">
                <label for="Street">Rua</label>
                <input id="Street" name="Street" required/>
            </div>
            <div class="field">
                <label for="Number">Número</label>
                <input id="Number" name="Number" required/>
            </div>
            <div class="field">
                <label for="Complement">Complemento</label>
                <input id="Complement" name="Complement"/>
            </div>
            <div class="field">
                <label for="City">Cidade</label>
                <input id="City" name="City" required/>
            </div>
            <div class="field">
                <label for="State">UF</label>
                <input id="State" name="State" maxlength="2" required/>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-2">Salvar endereço</button>
    </form>
</section>
