@model Iscuissatis.Web.Models.CheckoutFormModel
@{
    var cart = ViewData["Cart"] as Iscuissatis.Domain.Sales.Cart;
}

<section class="container-page py-10">
    <h1 class="text-3xl md:text-[38px] text-primary">Finalizar compra</h1>
    <p class="mt-2 text-sm text-muted">
        O pedido é criado aguardando pagamento e o estoque fica reservado por 30 minutos.
        O pagamento por Pix entra na próxima etapa do projeto.
    </p>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-start">
        <form method="post" asp-action="Index" class="card">
            <div asp-validation-summary="ModelOnly" class="form__error mb-4" role="alert"></div>

            <h2 class="text-lg">Entrega</h2>

            <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div class="field sm:col-span-2">
                    <label asp-for="Recipient"></label>
                    <input asp-for="Recipient" autocomplete="name"/>
                    <span asp-validation-for="Recipient" class="form__error"></span>
                </div>

                <div class="field">
                    <label asp-for="ZipCode"></label>
                    <input asp-for="ZipCode" id="zipCode" inputmode="numeric" autocomplete="postal-code"
                           placeholder="18300-000" maxlength="9"/>
                    <span asp-validation-for="ZipCode" class="form__error"></span>
                    <span id="zipHint" class="text-xs text-muted"></span>
                </div>

                <div class="field">
                    <label asp-for="District"></label>
                    <input asp-for="District" id="district" autocomplete="address-level3"/>
                </div>

                <div class="field sm:col-span-2">
                    <label asp-for="Street"></label>
                    <input asp-for="Street" id="street" autocomplete="address-line1"/>
                    <span asp-validation-for="Street" class="form__error"></span>
                </div>

                <div class="field">
                    <label asp-for="Number"></label>
                    <input asp-for="Number" autocomplete="address-line2"/>
                    <span asp-validation-for="Number" class="form__error"></span>
                </div>

                <div class="field">
                    <label asp-for="Complement"></label>
                    <input asp-for="Complement"/>
                </div>

                <div class="field">
                    <label asp-for="City"></label>
                    <input asp-for="City" id="city" autocomplete="address-level2"/>
                    <span asp-validation-for="City" class="form__error"></span>
                </div>

                <div class="field">
                    <label asp-for="State"></label>
                    <input asp-for="State" id="state" maxlength="2" autocomplete="address-level1"/>
                    <span asp-validation-for="State" class="form__error"></span>
                </div>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="field sm:col-span-2">
                        <label asp-for="GuestEmail"></label>
                        <input asp-for="GuestEmail" type="email" autocomplete="email"
                               placeholder="voce@exemplo.com"/>
                        <span asp-validation-for="GuestEmail" class="form__error"></span>
                    </div>
                }
            </div>

            <fieldset class="mt-6">
                <legend class="font-display uppercase tracking-[0.08em] text-sm">Entrega</legend>
                <div id="opcoes-entrega">
                    <partial name="_OpcoesEntrega" model="@(ViewData["ShippingOptions"] as IReadOnlyList<Iscuissatis.Application.Shipping.ShippingOption> ?? new List<Iscuissatis.Application.Shipping.ShippingOption>())"/>
                </div>
            </fieldset>

            <button type="submit" class="btn btn-primary mt-4">Criar pedido</button>
        </form>

        <aside class="card">
            <h2 class="text-lg">Resumo</h2>
            <ul class="mt-4 space-y-3 text-sm">
                @if (cart is not null)
                {
                    @foreach (var item in cart.Items)
                    {
                        <li class="flex justify-between gap-3">
                            <span>@item.Quantity × @item.ProductName</span>
                            <span class="whitespace-nowrap">R$ @item.LineTotal.ToString("N2")</span>
                        </li>
                    }
                }
            </ul>
            <div class="mt-4 flex justify-between border-t border-line pt-3 font-bold">
                <span>Total</span>
                <span>R$ @(cart?.Subtotal.ToString("N2") ?? "0,00")</span>
            </div>
            <p class="mt-3 text-xs text-muted">Frete será calculado na etapa de envio.</p>
        </aside>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var zip = document.getElementById('zipCode');
            var hint = document.getElementById('zipHint');
            if (!zip) return;

            function atualizarEntrega(digits) {
                var container = document.getElementById('opcoes-entrega');
                if (!container) return;

                fetch('/checkout/frete?cep=' + digits)
                    .then(function (response) { return response.text(); })
                    .then(function (html) { container.innerHTML = html; })
                    .catch(function () { /* mantém o que estava */ });
            }

            zip.addEventListener('blur', function () {
                var digits = zip.value.replace(/\D/g, '');
                if (digits.length !== 8) return;

                fetch('/checkout/cep/' + digits)
                    .then(function (response) {
                        if (!response.ok) throw new Error('cep');
                        return response.json();
                    })
                    .then(function (address) {
                        document.getElementById('street').value = address.street || '';
                        document.getElementById('district').value = address.district || '';
                        document.getElementById('city').value = address.city || '';
                        document.getElementById('state').value = address.state || '';
                        hint.textContent = 'Endereço preenchido pelo CEP. Confira o número.';
                        atualizarEntrega(digits);
                    })
                    .catch(function () {
                        hint.textContent = 'Não conseguimos consultar o CEP agora. Preencha o endereço manualmente.';
                        atualizarEntrega(digits);
                    });
            });
        })();
    </script>
}
