@model IReadOnlyList<Iscuissatis.Application.Shipping.ShippingOption>

@if (Model.Count == 0)
{
    <p class="mt-2 text-sm text-muted" role="alert">
        Ainda não entregamos nesse CEP. Informe outro endereço ou fale com a saboaria.
    </p>
}
else
{
    <ul class="mt-3 space-y-2">
        @foreach (var option in Model)
        {
            var first = option == Model[0];
            <li class="flex items-center justify-between gap-3 rounded border border-line bg-surface px-4 py-3">
                <label class="flex items-center gap-3">
                    <input type="radio" name="ShippingCode" value="@option.Code" required
                           checked="@first" class="size-4 accent-primary"/>
                    <span class="text-sm">
                        @option.Name
                        <span class="block text-xs text-muted">
                            @option.EstimatedBusinessDays dia(s) útil(eis)
                            @if (option.IsPickup)
                            {
                                <span>· retirada combinada por WhatsApp</span>
                            }
                        </span>
                    </span>
                </label>
                <span class="text-sm font-bold">
                    @(option.Price == 0m ? "Grátis" : $"R$ {option.Price:N2}")
                </span>
            </li>
        }
    </ul>
}
