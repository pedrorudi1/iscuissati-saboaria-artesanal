# Copie para .env (local) ou cadastre cada variável na aba Environment do recurso no Coolify.
# NUNCA comite o .env.

# --- PostgreSQL ---
POSTGRES_DB=iscuissatis
POSTGRES_USER=iscuissatis
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Dentro do docker compose o host é "db"; no Coolify, use o host interno do serviço Postgres.
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=iscuissatis;Username=iscuissatis;Password=troque-por-uma-senha-forte

# --- Aplicação ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
Database__MigrateOnStartup=true
# NUNCA ligue em produção: cria produto fictício publicado.
Database__SeedDemo=false

# --- Segurança / proxy ---
# Cloudflare Tunnel encerra o TLS; redirecionar aqui cria loop.
Security__UseHttpsRedirection=false
# Atrás do Tunnel/proxy: faz a app enxergar https e IP real.
Security__TrustForwardedHeaders=true
# Volume para as chaves de criptografia (sessão, 2FA). Sem isso, todo deploy desloga todos.
Security__DataProtectionPath=/app/keys

# --- Armazenamento de imagens (volume) ---
Storage__RootPath=/app/media
Storage__PublicPrefix=/media
Storage__MaxUploadBytes=5242880

# --- Frete (valores de exemplo: ajustar antes de vender) ---
Shipping__OriginZip=18300000
Shipping__FreeShippingThreshold=150
Shipping__HandlingDays=2
Shipping__PickupEnabled=true
Shipping__PickupLabel=Retirar em Tatuí
Shipping__PickupInstructions=Rua a definir, Tatuí/SP — combinar horário por WhatsApp.
Shipping__DefaultItemWeightGrams=150

# --- Pagamentos ---
# "fake" apenas para desenvolvimento/demonstração; trocar quando o gateway for escolhido.
Payments__Provider=fake
Payments__WebhookSecret=troque-por-um-segredo-longo-e-aleatorio
Payments__PixExpirationMinutes=30
Payments__ExpirationWorker=true

# --- Analytics (só carrega após consentimento de cookies) ---
Analytics__Ga4Id=

# --- Administrador inicial (criado no primeiro start) ---
Seed__AdminEmail=admin@exemplo.com.br
Seed__AdminPassword=troque-por-uma-senha-forte
Seed__AdminFullName=Administrador
