# Copie para .env e ajuste. NUNCA comite o .env.
# No Coolify, cadastre cada variável na aba Environment do recurso.

# --- PostgreSQL ---
POSTGRES_DB=iscuissatis
POSTGRES_USER=iscuissatis
POSTGRES_PASSWORD=troque-esta-senha

# Usada pela aplicação (host "db" = serviço do docker compose).
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=iscuissatis;Username=iscuissatis;Password=troque-esta-senha

# --- Aplicação ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
# Cloudflare Tunnel encerra o TLS; o redirect local causaria loop.
Security__UseHttpsRedirection=false
Database__MigrateOnStartup=true

# --- Administrador inicial (criado no primeiro start) ---
Seed__AdminEmail=admin@exemplo.com.br
Seed__AdminPassword=troque-por-uma-senha-forte
Seed__AdminFullName=Administrador
